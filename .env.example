DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# TeenX child API boundary (disabled by default; values must be exactly true or false)
TEENX_CHILD_MODE=false
# Non-production local_trusted fixtures only. Never enable in production.
TEENX_ALLOW_LOCAL_IMPLICIT=false
# Required when Profile Gate A is configured or TEENX_CHILD_MODE=true.
# Generate each secret independently as canonical base64url for at least 32 random bytes.
TEENX_PROFILE_PUBLIC_ID_SECRET=
TEENX_PROFILE_BRIDGE_BASE_URL=https://profile.internal.example
TEENX_PROFILE_BRIDGE_SECRET=
TEENX_PROFILE_BRIDGE_KEY_ID=
TEENX_PROFILE_BRIDGE_TIMEOUT_MS=5000
TEENX_PROFILE_PUBLIC_ID_CACHE_TTL_MS=30000
TEENX_PROFILE_PUBLIC_ID_SCAN_CAP=10000
# Must be explicit whenever Profile Gate A is configured. true holds the SSO migration lock.
TEENX_PROFILE_SSO_MAINTENANCE_LOCK=true
TEENX_DISCOURSE_BASE_URL=https://forum.example
TEENX_DISCOURSE_CONNECT_SECRET=

# ADVX Arena judge (server-only; never expose these values to ui-advx)
ADVX_ARENA_MODEL_BASE_URL=
ADVX_ARENA_MODEL_API_KEY=
ADVX_ARENA_MODEL_NAME=deepseek
ADVX_ARENA_ALLOW_MOCK=false

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
